# Separate Ubuntu runtime and dedicated external database. Never share live game DB.
GAME_IMAGE=dnf-game:ubuntu24-v1
ADMIN_IMAGE=dnf-admin:local-fix-20261015
PUBLIC_IP=203.0.113.10
DB_HOST=10.2.4.12
DB_PORT=3306
DB_ROOT_PASSWORD=CHANGE_ME_RANDOM_HEX_32
# Exactly 8 alphanumeric characters: openssl rand -hex 4
GAME_DB_PASSWORD=CHANGE_ME
# ALL may leave empty. Split CORE MUST set a pattern covering every node's DB source,
# e.g. 10.2.4.% for a trusted private subnet (use actual DB-visible source addresses).
GAME_DB_ALLOW_IP=
SUPERVISOR_PASSWORD=CHANGE_ME_RANDOM_HEX_24
GATE_PASSWORD=CHANGE_ME_RANDOM_HEX_24
MYSQL_INIT_SSL_MODE=disabled
# Split deployment only. Set actual host addresses; documentation IPs are examples.
NODE_BIND_IP=10.2.4.10
CORE_IP=10.2.4.10
BRIDGE_IP=10.2.4.10
P2P_IP=203.0.113.12
P2P_RELAY_INDEX=1
