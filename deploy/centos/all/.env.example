# Test deployment only. Replace every CHANGE_ME value before running.
GAME_IMAGE=dnf-game:local-fix-20261015
ADMIN_IMAGE=dnf-admin:local-fix-20261015

# 203.0.113.10 is an EXAMPLE, not a usable server address.
PUBLIC_IP=203.0.113.10

# Use separate random alphanumeric values; avoid shell/SQL punctuation in this legacy stack.
DB_ROOT_PASSWORD=CHANGE_ME_RANDOM_HEX_32
# Exactly 8 characters. Generate with: openssl rand -hex 4
GAME_DB_PASSWORD=CHANGE_ME
SUPERVISOR_PASSWORD=CHANGE_ME_RANDOM_HEX_24
GATE_PASSWORD=CHANGE_ME_RANDOM_HEX_24


# Independently managed, dedicated MySQL instance (5.6.50 tested on the server).
# Replace with private IPv4 reachable FROM BOTH containers. Not 127.0.0.1.
DB_HOST=10.0.0.20
# Upstream my.cnf listens on 4000. Set actual reachable TCP port.
DB_PORT=3306
# Empty invokes upstream source-address detection; verify game@host after startup.
GAME_DB_ALLOW_IP=
# CLI initialization only; JDBC TLS is configured separately.
# disabled for this dedicated legacy test DB; auto keeps client TLS defaults.
MYSQL_INIT_SSL_MODE=disabled

# Optional absolute existing runtime root; default is ./runtime in this directory.
# RUNTIME_ROOT=/opt/dof/deploy/centos/all/runtime
